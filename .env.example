# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

# Quem escreve as respostas:
#   ollama    -> modelo local, gratuito (padrão)
#   anthropic -> Claude, pago por uso (precisa de ANTHROPIC_API_KEY)
IA_PROVEDOR=ollama

# Modelo local usado quando IA_PROVEDOR=ollama
# (se trocar, mude também o "ollama pull" no docker-compose.yml)
OLLAMA_MODELO_CHAT=qwen2.5:3b

# Só necessário quando IA_PROVEDOR=anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-5-5

# Segredo usado para assinar os tokens JWT (mínimo de 32 caracteres)
JWT_SEGREDO=

# Administrador criado na primeira vez que a aplicação sobe
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=
